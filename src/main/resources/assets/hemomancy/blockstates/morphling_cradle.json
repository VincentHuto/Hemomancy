{
  "multipart": [
    {
      "when": { "face": "floor", "facing": "north" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "y": 180 }
    },
    {
      "when": { "face": "floor", "facing": "east" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "y": 270 }
    },
    {
      "when": { "face": "floor", "facing": "south" },
      "apply": { "model": "hemomancy:block/morphling_cradle" }
    },
    {
      "when": { "face": "floor", "facing": "west" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "y": 90 }
    },
    {
      "when": { "face": "ceiling", "facing": "north" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "x": 180, "y": 180 }
    },
    {
      "when": { "face": "ceiling", "facing": "east" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "x": 180, "y": 270 }
    },
    {
      "when": { "face": "ceiling", "facing": "south" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "x": 180 }
    },
    {
      "when": { "face": "ceiling", "facing": "west" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "x": 180, "y": 90 }
    },
    {
      "when": { "face": "wall", "facing": "north" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "x": 90 }
    },
    {
      "when": { "face": "wall", "facing": "east" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "x": 90, "y": 90 }
    },
    {
      "when": { "face": "wall", "facing": "south" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "x": 90, "y": 180 }
    },
    {
      "when": { "face": "wall", "facing": "west" },
      "apply": { "model": "hemomancy:block/morphling_cradle", "x": 90, "y": 270 }
    }
  ]
}
