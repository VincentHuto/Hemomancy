      "apply": { "model": "hemomancy:block/anastomotic_brazier_lit" }
    },
    {
      "when": { "facing": "south", "ritual_phase": "1" },
      "apply": { "model": "hemomancy:block/anastomotic_brazier_lit", "y": 180 }
    },
    {
      "when": { "facing": "west", "ritual_phase": "1" },
      "apply": { "model": "hemomancy:block/anastomotic_brazier_lit", "y": 270 }
    },
    {
      "when": { "facing": "east", "ritual_phase": "1" },
      "apply": { "model": "hemomancy:block/anastomotic_brazier_lit", "y": 90 }
    }
  ]
