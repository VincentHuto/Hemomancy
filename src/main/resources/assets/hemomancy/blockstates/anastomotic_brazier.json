{
  "multipart": [
    {
      "when": { "facing": "north", "ritual_phase": "0" },
      "apply": { "model": "hemomancy:block/anastomotic_brazier" }
    },
    {
      "when": { "facing": "south", "ritual_phase": "0" },
      "apply": { "model": "hemomancy:block/anastomotic_brazier", "y": 180 }
    },
    {
      "when": { "facing": "west", "ritual_phase": "0" },
      "apply": { "model": "hemomancy:block/anastomotic_brazier", "y": 270 }
    },
    {
      "when": { "facing": "east", "ritual_phase": "0" },
