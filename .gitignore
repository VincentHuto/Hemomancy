# docs/: markdown is tracked everywhere. The archive keeps only its markdown; its
# evidence images, generated output and concept art stay local.
/docs/archive/**
!/docs/archive/**/
!/docs/archive/**/*.md
/docs/archive/concept/
/docs/superpowers/mockups/
/docs/**/__pycache__/
/output/
*.java~
__pycache__/

# tools/ holds local editors and art pipelines. Only the model generators that tests read, the review launchers, the mausoleum generator, the Brined Court generators, the Mason's Respite generator, the wayside sites generator and the Harbinger sites generator are tracked.
/tools/*
!/tools/model_export/
# The Circus puppet and faculty builders; their previews and old versions stay local.
!/tools/circus/
/tools/circus/*
!/tools/circus/*.py
!/tools/review/
# The Saint mausoleum structure generator writes the mausoleum templates, which are never hand-edited.
!/tools/worldgen/
/tools/worldgen/*
!/tools/worldgen/mausoleum/
!/tools/worldgen/mausoleum_complexes.py
!/tools/worldgen/brined_court/
!/tools/worldgen/brined_court_seats.py
!/tools/worldgen/brined_court_outposts.py
!/tools/worldgen/masons_respite.py
!/tools/worldgen/wayside/
!/tools/worldgen/wayside_sites.py
!/tools/worldgen/harbinger_sites/
!/tools/worldgen/harbinger_sites.py
.ignore
